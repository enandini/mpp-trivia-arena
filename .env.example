# Anthropic (only needed if running the ClaudeAgent demo bot)
ANTHROPIC_API_KEY=

# MPP / Tempo testnet
MPP_SECRET_KEY=
MPP_TESTNET=true

# Testnet: Chain 42431, RPC https://rpc.moderato.tempo.xyz
# Testnet USDC: 0x20c0000000000000000000000000000000000000

# Server wallet (receives entry fees, sponsors gas with feePayer:true)
# Fund with testnet tokens at https://faucet.tempo.xyz
SERVER_PRIVATE_KEY=
SERVER_ADDRESS=

# Demo agent wallets (optional -- only needed for demo bots)
# Each needs testnet USDC to pay per answer
# Fund all 4 at https://faucet.tempo.xyz
AGENT_0_KEY=
AGENT_0_ADDRESS=
AGENT_1_KEY=
AGENT_1_ADDRESS=
AGENT_2_KEY=
AGENT_2_ADDRESS=
AGENT_3_KEY=
AGENT_3_ADDRESS=

NEXT_PUBLIC_BASE_URL=http://localhost:3000
