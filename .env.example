ANTHROPIC_API_KEY=

# Demo bot wallets (optional -- skip if you only want external agents)
# Use fresh throwaway wallets. Fund each with testnet USDC.
AGENT_0_KEY=
AGENT_1_KEY=
AGENT_2_KEY=
AGENT_3_KEY=

NEXT_PUBLIC_BASE_URL=http://localhost:3000
